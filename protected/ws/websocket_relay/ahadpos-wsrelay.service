[Unit]
Description=Ahadpos Customer Display WebSocket Server
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/php /var/www/html/ahadpos3/protected/ws/websocket_relay/wsrelayrun.php
WorkingDirectory=/var/www/html/ahadpos3/protected/ws/websocket_relay/
Restart=always

[Install]
WantedBy=multi-user.target
